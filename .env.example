# football-data.org에서 발급받은 키를 넣고, 이 파일을 .env.local로 복사해서 쓰세요.
FOOTBALL_DATA_API_KEY=

# 카페(게시판·응원톡)용 Supabase 설정이에요. 비워 두면 카페 화면에 설정 안내만 보여요.
# 프로젝트 주소는 Supabase 대시보드의 Connect 버튼에, Publishable key는 Project Settings > API Keys에 있어요.
# 예: NEXT_PUBLIC_SUPABASE_URL=https://abcdefghijklmnopqrst.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 승부 예측을 맞힌 회원에게 골을 주고, 선수 맞히기의 정답 선수 사진을 읽는 데 쓰는 서버 전용 비밀 키예요
# (Project Settings > API Keys의 Secret key). 브라우저로 나가면 안 되는 키라 이름 앞에 NEXT_PUBLIC_을 절대 붙이지 마세요.
# 비워 두면 예측 골 지급과 선수 맞히기만 멈추고 출석 골과 나머지 기능은 그대로 돌아가요.
SUPABASE_SECRET_KEY=
