# football-data.org에서 발급받은 키를 넣고, 이 파일을 .env.local로 복사해서 쓰세요.
FOOTBALL_DATA_API_KEY=

# 카페(게시판·응원톡)용 Supabase 설정이에요. 비워 두면 카페 화면에 설정 안내만 보여요.
# Supabase 대시보드의 Connect 버튼이나 Project Settings > API Keys에서 프로젝트 주소와 Publishable key를 복사해 넣으세요.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
